APP_ENV=production
DATABASE_URL=postgresql+asyncpg://REPLACE_USER:REPLACE_PASSWORD@REPLACE_HOST:5432/REPLACE_DATABASE
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=2
ADMIN_SECRET=REPLACE_WITH_DISTINCT_RANDOM_SECRET
EVENT_EXPORT_SECRET=REPLACE_WITH_ANOTHER_RANDOM_SECRET
ENROLLMENT_PLANNER_SECRET=REPLACE_WITH_A_THIRD_RANDOM_SECRET
PG_CA_CERT_FILE=
ENROLLMENT_POLICY_FILE=/etc/claw/enrollment-policy.json
ENROLLMENT_EMAIL_DOMAINS=
# Existing competition alert delivery; configure if used.
DISCORD_WEBHOOK_URL=
CORS_ORIGINS=
LOG_LEVEL=INFO
