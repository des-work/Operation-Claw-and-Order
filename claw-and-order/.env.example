# ── Claw & Order — Environment Configuration ────────────────────────────
# Copy this file to .env and fill in your values.
# All variables have sensible defaults except ADMIN_SECRET (required).

# ── Database ─────────────────────────────────────────────────────────────
# SQLite (development):
DATABASE_URL=sqlite+aiosqlite:///./claw_and_order.db
# PostgreSQL (production):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/claw_and_order
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=2

# ── Authentication (REQUIRED) ───────────────────────────────────────────
# Shared secret for admin endpoints (POST /api/admin/phase)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_SECRET=
# Independent read-only credential for dashboard event export
EVENT_EXPORT_SECRET=
APP_ENV=development

# ── Discord Integration (optional) ──────────────────────────────────────
# Preferred: a shared instructor webhook, or a private file with class routes.
# Use ONE of these settings. Leave DISCORD_TOKEN empty in webhook mode.
DISCORD_WEBHOOK_URL=
DISCORD_WEBHOOKS_FILE=
DISCORD_WEBHOOKS_JSON=
# See config/discord-webhooks.example.json for per-class routing.
# Bot token from https://discord.com/developers/applications
DISCORD_TOKEN=
# Channel ID for competition alerts (right-click channel → Copy ID)
DISCORD_CHANNEL_ID=0
# Student enrollment uses a separate bot identity/process; it can run alongside alert webhooks.
ENROLLMENT_POLICY_FILE=
ENROLLMENT_DISCORD_BOT_TOKEN=
# Optional comma-separated college email domains; no domain is guessed.
ENROLLMENT_EMAIL_DOMAINS=
# Operator CLI API origin; HTTPS required except for loopback development.
CLAW_BACKEND_URL=http://127.0.0.1:8000
# Optional invitation mailer: plan/review first; importing never sends email.
ENROLLMENT_SMTP_HOST=
ENROLLMENT_SMTP_FROM=
ENROLLMENT_SMTP_TLS=ssl
# Defaults: 465 for ssl, 587 for starttls.
ENROLLMENT_SMTP_PORT=
ENROLLMENT_SMTP_USER=
ENROLLMENT_SMTP_PASSWORD=
CORS_ORIGINS=

# ── Logging ──────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Tuning (optional) ───────────────────────────────────────────────────
# Max queued SSE messages per connected dashboard client
SSE_MAX_QUEUE_SIZE=256
# Max characters stored in event raw_output field
RAW_OUTPUT_MAX_LENGTH=2000
